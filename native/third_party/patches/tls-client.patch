+// Close closes every cached transport — HTTP/3 ones with their UDP sockets, which
+// CloseIdleConnections leaves open — and connections stashed by dialTLS. Responses
+// still being read are left alone: HTTP/3 transports close after them, HTTP/1.1 and
+// HTTP/2 ones close idle connections only.
+func (rt *roundTripper) Close() {
+	var transports []http.RoundTripper
+	if rt.racer != nil {
+		rt.racer.close()
+	}
+	rt.cachedTransportsLck.Lock()
+	rt.closed = true
+	for addr, transport := range rt.cachedTransports {
+		transports = append(transports, transport)
+		delete(rt.cachedTransports, addr)
+	}
+	rt.cachedTransportsLck.Unlock()
+	rt.cachedKindsLck.Lock()
+	rt.cachedKinds = make(map[string]transportKind)
+	rt.cachedKindsLck.Unlock()
+	for _, transport := range transports {
+		closeTransport(transport)
+	}
+	rt.closeH2C()
+
+	rt.Lock()
+	for addr, conn := range rt.cachedConnections {
+		_ = conn.Close()
+		delete(rt.cachedConnections, addr)
+	}
+	rt.Unlock()
+}
+
+// discardCachedConnection closes the connection dialTLS stashed for addr, if any.
+func (rt *roundTripper) discardCachedConnection(addr string) {
+	rt.Lock()
+	conn := rt.cachedConnections[addr]
+	delete(rt.cachedConnections, addr)
+	rt.Unlock()
+	if conn != nil {
+		_ = conn.Close()
+	}
 }
 
