+	// yumeclient: RFC 7366. The server acknowledges encrypt_then_mac only for a CBC
+	// suite; an acknowledgement for another suite is ignored, as OpenSSL does
+	if hs.serverHello.encryptThenMAC {
+		if !hs.offeredEncryptThenMAC() {
+			c.sendAlert(alertUnsupportedExtension)
+			return errors.New("tls: server sent an unsolicited encrypt_then_mac extension")
+		}
+		_, isCBC := clientCipher.(cbcMode)
+		c.in.nextEncryptThenMAC = isCBC
+		c.out.nextEncryptThenMAC = isCBC
+	}
 	return nil
+}
+
+// offeredEncryptThenMAC reports whether the ClientHello carried encrypt_then_mac
+// (uTLS specs add it as GenericExtension{Id: 22}).
+func (hs *clientHandshakeState) offeredEncryptThenMAC() bool {
+	if hs.uconn == nil {
+		return false
+	}
+	for _, ext := range hs.uconn.Extensions {
+		if e, ok := ext.(*GenericExtension); ok && e.Id == fakeExtensionEncryptThenMAC {
+			return true
+		}
+	}
+	return false
 }
 
